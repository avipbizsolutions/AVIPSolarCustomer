<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Customer" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorSecondary">@color/sun</item>
        <item name="colorOnSecondary">#14211B</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Customer.Splash">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
